#!/bin/sh
# Start versitygw; /init has already dropped to the run user.

export HOME=/config

echo "[INFO] Starting versitygw..."

cd /config
exec /usr/local/bin/versitygw \
	--access "${ROOT_ACCESS_KEY_ID}" \
	--secret "${ROOT_SECRET_ACCESS_KEY}" \
	--port 0.0.0.0:7070 \
        --webui 0.0.0.0:7071 \
        --cors-allow-origin \* \
	posix /config
